# Baseline hardening on every response. frame-ancestors is 'self', not 'none', because the
# trading desk frames this front end through its own gateway origin.
trading.damianhoward.com {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'self'"
	}
	encode zstd gzip
	log {
		output file /var/log/caddy/trading.log {
			mode 0644
		}
		format json
	}
	reverse_proxy localhost:8082 {
		flush_interval -1
	}
}
