[Unit]
Description=Positions, risk and PnL over the orderbook fill stream
After=network.target

[Service]
Environment=JAVA_HOME=/opt/jdk25
Environment=JAVA_OPTS=-Xmx128m
# Box-local config: PORT, KAFKA_BOOTSTRAP_SERVERS, and the DB triple (required at startup).
EnvironmentFile=/etc/trading-system/env
ExecStart=/home/ubuntu/trading-system/bin/trading-system
Restart=on-failure
RestartSec=2
User=ubuntu

# Sandboxing. This service holds the Autonomous DB wallet and the Kafka SCRAM credential and owns
# the book of record, so bounding the blast radius of a defect in it matters more here than
# anywhere else on the estate. It writes nothing to disk — the ledger and positions are in the
# database, the consumer's position is in the ledger — so /etc/trading-system stays readable and
# nothing is writable. `systemd-analyze security trading-system.service` reports the result.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# MemoryDenyWriteExecute is deliberately absent rather than set false, so it does not get added
# later: the JVM writes JIT-compiled code and then executes it, and enabling it kills the process
# at the first compilation.
#
# Sized from the observed peak (183 MB — the highest on the estate, since the Oracle driver and the
# Kafka consumer both hold buffers) against a 128 MB heap. Generous on purpose: the failure mode
# this service must not have is being OOM-killed mid-transaction on a cap that was set too tight.
MemoryMax=448M
TasksMax=256

[Install]
WantedBy=multi-user.target
