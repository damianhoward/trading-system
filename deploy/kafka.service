[Unit]
Description=Kafka (KRaft, single-node)
After=network.target

[Service]
Type=simple
User=ubuntu
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# Quoted, and that is load-bearing. systemd splits an unquoted Environment= on whitespace and
# treats each fragment as its own KEY=VALUE, so `Environment=KAFKA_HEAP_OPTS=-Xmx400m -Xms400m`
# parsed as one valid assignment plus the invalid token `-Xms400m`, which it discarded with a
# warning nobody was reading. The broker ran without its -Xms for its whole life while the unit
# claimed otherwise.
#
# 400 MB is correct and must not be trimmed on the basis of resident memory. RSS reads ~180 MB,
# which looks like a heap sitting idle at less than half its ceiling; it is not. Forcing a full GC
# (jcmd PID GC.run) leaves 241 MB live, so the broker genuinely needs most of this heap and the
# rest of it is in swap rather than unused. A 256 MB ceiling would sit barely above the live set
# and put the broker into continuous full GCs, or out of memory.
#
# The lesson generalises: on a swapping box RSS understates a JVM's heap requirement, because the
# kernel has evicted pages the heap still owns. Measure the live set after a collection.
#
# -Xms stays unset on purpose. Pre-committing the heap is the right call on a dedicated broker and
# the wrong one here: this box has 954 MB and shares it with trading-system.
Environment="KAFKA_HEAP_OPTS=-Xmx400m"
ExecStart=/home/ubuntu/kafka/bin/kafka-server-start.sh /home/ubuntu/kafka/config/kraft-single.properties
ExecStop=/home/ubuntu/kafka/bin/kafka-server-stop.sh
Restart=on-failure
RestartSec=5

# A ceiling, not a reservation: it costs nothing until something runs away, and this was the only
# unit on either box with no bound at all. Sits above the 400 MB heap plus the non-heap the broker
# measurably uses — 53 MB of metaspace, plus direct buffers for network and log I/O and thread
# stacks. Deliberately not tighter: this bounds a runaway, it does not ration normal operation.
MemoryMax=640M
TasksMax=512

# Deliberately lighter than the application units. The broker execs shell scripts, writes its log
# segments under /home/ubuntu, and is the one process here whose failure takes the estate's spine
# with it, so the confinement is limited to what is provably safe rather than the full set.
NoNewPrivileges=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
